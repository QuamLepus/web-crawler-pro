# ============================================================================
# WebCrawler Pro — environment template
# Copy to .env and fill in real values. NEVER commit a populated .env.
# Variables below mirror every os.getenv() lookup in src/, workers/ and main.py.
# ============================================================================

# ---- core crawler ----
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; WebCrawlerPro/1.0)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_LOG_LEVEL=INFO
CRAWLER_LOG_FILE=
CRAWLER_OUTPUT_DIR=output
CRAWLER_MAX_CONCURRENT=10
CRAWLER_MAX_PAGES=100
CRAWLER_DELAY=0.5
CRAWLER_ALLOWED_DOMAINS=
LOG_LEVEL=INFO

# ---- distributed architecture ----
REDIS_URL=redis://localhost:6379/0
FRONTIER_NAMESPACE=frontier
DEDUPE_THRESHOLD=0.9
DEDUPE_BACKEND=minhash           # minhash | exact
DL_PER_HOST_RPS=2
DL_MAX_CONCURRENCY=8
DL_RETRIES=3
DL_TIMEOUT=30

# ---- anti-bot / stealth ----
PROXY_DATACENTER=http://user:pass@dc-gateway.example.com:8000
PROXY_RESIDENTIAL=http://user:pass@res-gateway.example.com:8000
PROXY_MOBILE=
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha        # or anti-captcha
HEADLESS=1

# ---- storage backends ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ELASTICSEARCH_URL=http://localhost:9200
POSTGRES_HOST=localhost
POSTGRES_DB=crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler        # REQUIRED in production; rotate before deploy

# S3 / compatible object store
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCS / Azure / B2 (only set the backend you use)
GCS_BUCKET=
GCP_PROJECT=
AZURE_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=
B2_ENDPOINT=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=

# ---- API gateway / auth (SaaS layer) ----
JWT_SECRET=                      # REQUIRED, no default — app refuses to start
                                 # without it. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_OLD_SECRETS=                 # comma-separated previous secrets for rotation
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
CORS_ORIGINS=https://app.webcrawlerpro.example
# Early enterprise OIDC SSO; leave unset to keep provider setup disabled.
WCP_PUBLIC_BASE_URL=https://console.example.com
WCP_SSO_ENCRYPTION_KEY=        # Fernet key; generate with cryptography.fernet.Fernet.generate_key()

# ---- billing (Stripe) ----
STRIPE_SECRET_KEY=               # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (signs /billing/webhook payloads)
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_ENTERPRISE=price_enterprise

# ---- AI / ML ----
OPENAI_API_KEY=
HF_TOKEN=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hash          # hash | openai | sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2
ST_MODEL=all-MiniLM-L6-v2
SENTENCE_MODEL=all-MiniLM-L6-v2
FASTTEXT_MODEL=lid.176.bin
RAG_BACKEND=auto                 # auto | chroma | qdrant | memory
QDRANT_URL=
RAY_MODE=auto                    # auto | inline (local dev)

# ---- agents / curation ----
CURATOR_MODEL=gpt-4o-mini
SYNTH_MODEL=gpt-4o-mini
SEMDEDUP_THRESHOLD=0.85
TOXIC_THRESHOLD=0.8
PERSPECTIVE_API_KEY=

# ---- training / big-data compute ----
SPARK_MASTER=local[*]
SPARK_PARTITIONS=8
PACK_SEQ_LEN=4096
OUTPUT_PARTS=1
USE_RAPIDS=0                     # 1 to enable GPU (RAPIDS/cuDF) paths

# ---- topic discovery (src/discovery) ----
DISCOVERY_PROVIDERS=duckduckgo    # add `own` to prefer our own search index
DISCOVERY_MAX_CANDIDATES=300
DISCOVERY_MAX_QUERIES=6
DISCOVERY_TIMEOUT=20
DISCOVERY_MAX_PAGES_PER_SITE=5
DISCOVERY_BLOCKLIST=
DISCOVERY_USE_LLM=false
DISCOVERY_USE_COMMONCRAWL=false
DISCOVERY_USE_OWN_INDEX=true      # auto-register OwnIndexProvider when built
BRAVE_API_KEY=
SERPAPI_KEY=
TAVILY_API_KEY=

# ---- own search index (src/search_index) ----
# Build with: python -m src.cli search-index build --level N
SEARCH_INDEX_DIR=data/search-index
SEARCH_INDEX_LEVEL=0              # 0 curlie | 1 +wikipedia | 2 +10M CC | 3 +100M CC
SEARCH_INDEX_SHARD_DOCS=100000
SEARCH_INDEX_BODY_CHARS=512
SEARCH_INDEX_MAX_PAGES=0          # 0 = whatever the level says
SEARCH_INDEX_LANGUAGE=en
SEARCH_INDEX_SOURCES=             # comma-separated override, e.g. curlie,wikipedia
SEARCH_INDEX_AUTHORITY_WEIGHT=0.35
SEARCH_INDEX_SNIPPET_WIDTH=240
SEARCH_INDEX_COLLAPSE_HOST=true
SEARCH_INDEX_MMAP=true
SEARCH_INDEX_MAX_LOADED_SHARDS=8

# --- optional layers on top of BM25 --------------------------------------- #
# Semantic reranking: BM25 shortlists, an encoder reorders.
#   none              BM25 + authority only (default, zero extra cost)
#   embedding         bi-encoder cosine (needs: pip install sentence-transformers)
#   cross-encoder     slower + sharper (needs the same package, downloads a
#                     ~90 MB model the first time it runs)
SEARCH_INDEX_RERANK=none
SEARCH_INDEX_RERANK_WEIGHT=0.35        # 0 = ignore semantics, 1 = semantics only
SEARCH_INDEX_RERANK_CANDIDATES=100    # how many BM25 hits the reranker sees
SEARCH_INDEX_EMBED_MODEL=all-MiniLM-L6-v2
# Pre-compute vectors at build time (docs x 384 x 4 bytes: ~154 MB per 100k docs)
SEARCH_INDEX_EMBEDDINGS=false
# Typo correction trained on the index's own vocabulary, not a generic English
# dictionary — so it knows "kubernetes" and will not "fix" it.
SEARCH_INDEX_SPELL=true
SEARCH_INDEX_SPELL_MAX_TERMS=30000
# Re-ingesting a crawl: skip pages whose indexed text did not change.
SEARCH_INDEX_INCREMENTAL=true

# ---- observability ----
SENTRY_DSN=
DEPLOY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_PORT=8000
OTEL_SERVICE_NAME=webcrawlerpro-api
OTEL_WORKER_SERVICE_NAME=webcrawlerpro-worker
# Install requirements-otel.txt to export these spans to an OTLP/gRPC collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Web Crawler Pro - Configuration Template

# Base Configuration
BASE_URL=https://example.com
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Request Settings
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
DELAY_BETWEEN_REQUESTS=1

# Database (optional)
DATABASE_URL=sqlite:///crawler.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log

# Proxy (optional)
USE_PROXY=False
PROXY_URL=http://proxy.example.com:8080

# API Keys (if needed)
API_KEY=your_api_key_here
# Optional: enables HMAC-SHA256 signatures for POST /api/v1/provenance/manifest.
# Use a long random secret from your deployment secret manager; never commit the real value.
WCP_PROVENANCE_SIGNING_KEY=
